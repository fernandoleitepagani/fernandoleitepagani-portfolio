# ─────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in the values:
#   cp .env.example .env.local
#
# In Vercel: Project Settings → Environment Variables → add each key.
# The VITE_ prefix is required so Vite exposes them to the browser.
# ─────────────────────────────────────────────────────────────

# EmailJS — https://dashboard.emailjs.com/admin
# 1. Create an account and add an email service (Gmail, Proton, etc.)
# 2. Create two templates. Variable names must match what Contact.tsx sends:
#    {{name}}, {{email}}, {{message}}, {{title}}, {{time}}
# 3. Account → General → copy the Public Key
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID_FOR_ME=      # notification template (sent to you)
VITE_EMAILJS_TEMPLATE_ID_FOR_SENDER=  # auto-reply template (sent to visitor)
VITE_EMAILJS_PUBLIC_KEY=